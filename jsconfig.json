{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "bin/**/*.mjs",
    "src/**/*.mjs"
  ]
}
